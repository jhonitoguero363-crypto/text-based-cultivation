# 复制为 .env 后填写。勿把真实 Key 提交进仓库。

PORT=8787
HOST=0.0.0.0

# 网关鉴权：请求头 Authorization: Bearer <此值>
# 留空则不校验（仅建议本机；正式环境可在腾讯云容器环境变量中设置）
GATEWAY_TOKEN=

# ----- LLM（OpenAI 兼容）-----
# 智谱示例：
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash
# 硅基流动示例：
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
# 百炼兼容示例：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-flash

LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# 推理超时（毫秒）、温度、最大生成 token
CHAT_TIMEOUT_MS=8000
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=280

# 按 playerId（或 IP）每日请求上限
DAILY_LIMIT=30
